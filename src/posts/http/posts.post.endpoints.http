# Create post without meta options
POST http://localhost:4080/posts
Content-Type: application/json

{
  "title": "What's new with NestJS",
  "postType": "post",
  "slug": "new-with-nest-js-1",
  "schema": "{\"@context\": \"https://schema.org\", \"@type\": \"Person\"}",
  "status": "draft",
  "content": "post-content",
  "featuredImageUrl": "http://localhost.com/images/image1.jpg",
  "publishOn": "2024-03-16T07:46:32+0000",
  "tags": [
    "nestJS",
    "typescript"
  ]
}

###

# Create post WITH meta options
# Note: metaOptions.metaValue accepts an object that will be stored as JSON
# The cascade will automatically create the MetaOption entity
POST http://localhost:4080/posts
Content-Type: application/json

{
  "title": "NestJS with Meta Options",
  "postType": "post",
  "slug": "nest-js-with-meta-2",
  "schema": "{\"@context\": \"https://schema.org\", \"@type\": \"Person\"}",
  "status": "draft",
  "content": "post-content with meta options",
  "featuredImageUrl": "http://localhost.com/images/image1.jpg",
  "publishOn": "2024-03-16T07:46:32+0000",
  "tags": [
    "nestJS",
    "typescript"
  ],
  "metaOptions": {
    "metaValue": { 
      "sidebarEnabled": true, 
      "footerActive": true 
    }
  }
}